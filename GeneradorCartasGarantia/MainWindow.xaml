<Window x:Class="GeneradorCartasGarantia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Garantías C# - by Arlinton Feliz" Height="380" Width="500" 
       
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Realizado por Arlinton Feliz" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Foreground="#333333" 
                       HorizontalAlignment="Right" 
                       Margin="0,0,0,5"/>
            
            <Separator Background="#DCDCDC" Margin="0,0,0,15"/>

            <TextBlock Text="Generador de Cartas de Garantía" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10" 
                       Foreground="#1A1A1A"/>
            
            <TextBlock Text="Seleccione el tipo de proceso a realizar:" 
                       FontSize="14" 
                       Foreground="#666666" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <Button Content="📦 Garantía para CLIENTE" Height="60" Margin="0,10" 
                    Background="#2196F3" Foreground="White" FontSize="16" FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnCliente_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="🏢 Garantía para TIENDA" Height="60" Margin="0,10" 
                    Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnTienda_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>