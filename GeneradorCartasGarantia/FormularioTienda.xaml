<Window x:Class="GeneradorCartasGarantia.FormularioTienda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos de Garantía Tienda - by Arlinton Feliz" Height="550" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Información de Garantía" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <Label Content="Taller / Destinatario:"/>
            <TextBox x:Name="txtTaller" Margin="0,0,0,10"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <Label Content="Material:"/>
                    <TextBox x:Name="txtMaterial" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <Label Content="Marca:"/>
                    <TextBox x:Name="txtMarca" Margin="0,0,0,10"/>
                </StackPanel>
            </UniformGrid>

            <Label Content="Descripción del Producto:"/>
            <TextBox x:Name="txtDescripcion" Margin="0,0,0,10"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <Label Content="Modelo:"/>
                    <TextBox x:Name="txtModelo" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <Label Content="Serie:"/>
                    <TextBox x:Name="txtSerie" Margin="0,0,0,10"/>
                </StackPanel>
            </UniformGrid>

            <Label Content="Observaciones:"/>
            <TextBox x:Name="txtObservaciones" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <Label Content="Nombre para Firma:"/>
            <TextBox x:Name="txtFirma" Margin="0,0,0,20"/>

            <Button Content="Generar Documento PDF" Height="40" Background="#2196F3" Foreground="White" Click="BtnGenerar_Click"/>
        </StackPanel>
    </Grid>
</Window>