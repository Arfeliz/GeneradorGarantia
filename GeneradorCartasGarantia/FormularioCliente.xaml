<Window x:Class="GeneradorCartasGarantia.FormularioCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Garantía de Cliente - by Arlinton Feliz" Height="700" Width="550" WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="DATOS DE LA GARANTÍA" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="#D32F2F"/>
            
            <Label Content="Taller / Centro de Servicio:"/>
            <TextBox x:Name="txtTaller" Margin="0,0,0,10"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <Label Content="Nombre del Cliente:"/>
                    <TextBox x:Name="txtNombre" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <Label Content="Cédula:"/>
                    <TextBox x:Name="txtCedula" Margin="0,0,0,10"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,5,0">
                    <Label Content="Fecha Compra:"/>
                    <TextBox x:Name="txtFechaCompra" Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel Margin="5,0,5,0">
                    <Label Content="Artículo:"/>
                    <TextBox x:Name="txtTipoArticulo" Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <Label Content="Tiempo Garantía:"/>
                    <TextBox x:Name="txtTiempoGarantia" Margin="0,0,0,10" />
                </StackPanel>
            </UniformGrid>

            <Separator Margin="0,10"/>
            <TextBlock Text="Detalles del Producto (Tabla)" FontWeight="SemiBold" Margin="0,5"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                    <Label Content="Material:"/>
                    <TextBox x:Name="txtMaterial" Margin="0,0,0,10"/>
                    <Label Content="Descripción:"/>
                    <TextBox x:Name="txtDescripcion" Margin="0,0,0,10"/>
                    <Label Content="Modelo:"/>
                    <TextBox x:Name="txtModelo" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <Label Content="Marca:"/>
                    <TextBox x:Name="txtMarca" Margin="0,0,0,10"/>
                    <Label Content="Precio:"/>
                    <TextBox x:Name="txtPrecio" Margin="0,0,0,10"/>
                    <Label Content="Serie:"/>
                    <TextBox x:Name="txtSerie" Margin="0,0,0,10"/>
                </StackPanel>
            </UniformGrid>

            <Label Content="Ticket:"/>
            <TextBox x:Name="txtTicket" Margin="0,0,0,10"/>

            <Label Content="Firma Responsable (Nombre):"/>
            <TextBox x:Name="txtFirma" Margin="0,0,0,20"/>

            <Button Content="GENERAR CARTA DE GARANTÍA" Height="50" Background="#D32F2F" Foreground="White" FontWeight="Bold" Click="BtnGenerar_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>